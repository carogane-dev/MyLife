DATABASE_URL="postgresql://monapp:monapp@localhost:5432/monapp?schema=public"
PORT=3001
SESSION_COOKIE_SECRET=changeme-generate-a-long-random-string
# Liste séparée par des virgules. http://localhost:5173 suffit pour le
# navigateur/PWA et `tauri dev` (desktop) ; ajoute http://tauri.localhost
# pour utiliser l'app desktop packagée (`tauri build`, voir CLAUDE.md).
CORS_ORIGIN=http://localhost:5173,http://tauri.localhost
SEED_USER_EMAIL=ton-email@exemple.com
# Reconnaissance de plats par photo (routes/meals.ts) — crée ta propre clé
# sur console.anthropic.com. Sans elle, la fonctionnalité reste utilisable
# en saisie manuelle uniquement (dégradation propre, pas de crash).
ANTHROPIC_API_KEY=
